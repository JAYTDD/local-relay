# 派生的依赖副本。shims/node_modules 是入库的核心资产，
# 这里只是它的副本，靠 npm run sync:deps 重建（别手改 node_modules）。
/node_modules/

# 前端依赖与构建产物
/panel/node_modules/
/panel/dist/

# 运行时与本地临时文件
*.log
.DS_Store
Thumbs.db

# 本地私有的环境变量与编辑器目录
.env
.env.*
*.local
.idea/
.vscode/

# 本地排查残留：ACL 诊断报告与一次性探针脚本
/.dsh-acl-report/
/.probe.mjs
/probe-*.mjs

# 工具自留地：ZCode 的会话/计划缓存，不是项目内容
/.zcode/

# DSH 插件的运行时存储（记忆块等），文件留在本地给 DSH 用，不入库
/.dsh/
